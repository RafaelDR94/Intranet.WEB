{
  "name": "intranet.web",
  "version": "1.50.25",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write .",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "lint:errors": "next lint --quiet",
    "lint:warnings": "next lint | Select-String -Pattern \"warning\"",
    "export": "next export",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "deploy:storybook": "npm run build-storybook && firebase deploy --only hosting:drintranettecnicdocumentation",
    "deploy:app": "npm run build && firebase deploy --only hosting:intranetdr",
    "deploy:stagging": "npm run build && firebase deploy --only hosting:stagginsite",
    "deploy:preview": "npm run build  && firebase hosting:channel:deploy localbranch --only intranetdr",
    "deploy:e2e:report": "playwright test --reporter=html && firebase deploy --only hosting:intranetdr-testing"
  },
  "dependencies": {
    "@azure/msal-browser": "^4.16.0",
    "@floating-ui/dom": "^1.7.3",
    "@floating-ui/react-dom": "^2.1.5",
    "@react-pdf/renderer": "^4.3.0",
    "axios": "^1.11.0",
    "clsx": "^2.1.1",
    "dexie": "^4.0.11",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "firebase": "^12.0.0",
    "formik": "^2.4.6",
    "lucide-react": "^0.533.0",
    "next": "15.4.3",
    "next-pwa": "^5.6.0",
    "react": "19.1.0",
    "react-datepicker": "^8.4.0",
    "react-dom": "19.1.0",
    "react-signature-canvas": "^1.1.0-alpha.2",
    "use-sync-external-store": "^1.5.0",
    "workbox-expiration": "^7.3.0",
    "yup": "^1.6.1",
    "zustand": "^5.0.7"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-react": "^7.27.1",
    "@mdx-js/loader": "^3.1.0",
    "@mdx-js/react": "^2.3.0",
    "@playwright/test": "^1.55.0",
    "@storybook/addon-a11y": "^8.6.14",
    "@storybook/addon-docs": "^8.6.14",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-postcss": "^2.0.0",
    "@storybook/mdx2-csf": "^1.1.0",
    "@storybook/nextjs": "^8.6.14",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/dexie": "^1.3.32",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "@vitest/ui": "^3.2.4",
    "autoprefixer": "^10.4.21",
    "babel-loader": "^10.0.0",
    "css-loader": "^6.11.0",
    "eslint": "^9.35.0",
    "eslint-config-next": "15.5.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "jsdom": "^26.1.0",
    "next-svgr": "^0.0.2",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "pwa-asset-generator": "^8.1.1",
    "storybook": "^8.6.14",
    "tailwindcss": "^4.1.11",
    "typescript": "^5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  }
